# Jenkins master con cliente Docker incluido.
# Uso: permite que el pipeline ejecute docker build / docker compose
#       conectándose al daemon del host a través del socket montado.
# Build:   docker build -f Dockerfile.jenkins -t jenkins-with-docker .
# Run:     docker run -d --name jenkins --network jenkins-net \
#             -p 8080:8080 -p 50000:50000 \
#             -v jenkins_home:/var/jenkins_home \
#             -v //var/run/docker.sock:/var/run/docker.sock \
#             jenkins-with-docker
FROM jenkins/jenkins:lts-jdk21

USER root
# Cliente Docker + plugin Docker Compose v2 + utilidades.
# docker.io no incluye el subcomando 'docker compose', por eso se instala el
# paquete docker-compose-plugin. Si el repos Debian no lo provee, se descarga el
# binario oficial de GitHub al cli-plugins del usuario root.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io ca-certificates curl \
    ; if apt-get install -y --no-install-recommends docker-compose-plugin; then \
        echo "compose-plugin instalado por apt"; \
      else \
        echo "Descargando docker-compose v2 desde GitHub"; \
        mkdir -p /root/.docker/cli-plugins; \
        curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" -o /root/.docker/cli-plugins/docker-compose; \
        chmod +x /root/.docker/cli-plugins/docker-compose; \
      fi \
    && rm -rf /var/lib/apt/lists/*

# Entrada: corrige permisos de las claves SSH montadas (/root/.ssh) antes de iniciar Jenkins.
# Necesario porque al montar .ssh desde Windows los permisos llegan como 0777 y
# OpenSSH los rechaza. Se define un ENTRYPOINT propio que ejecuta /usr/local/bin/jenkins.sh
# del usuario jenkins tras ajustar los permisos.
COPY entrypoint.sh /usr/local/bin/jenkins-entrypoint.sh
RUN chmod +x /usr/local/bin/jenkins-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/jenkins-entrypoint.sh"]