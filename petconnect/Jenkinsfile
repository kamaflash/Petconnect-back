pipeline {
    agent any

    tools {
        maven 'maven'
        jdk 'jdk21'
    }

    environment {
        IMAGE_NAME = 'petconnect'
        IMAGE_TAG  = "${env.GIT_COMMIT?.take(7) ?: 'latest'}"
        REGISTRY   = ''  // Déjalo vacío si no subes a DockerHub
    }

    stages {
        // 1. Checkout del código (ahora usa la credencial correcta)
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'git@github.com:kamaflash/Petconnect-back.git',
                    credentialsId: 'Pet-git-private'
            }
            post {
                success {
                    script {
                        echo "Commit: ${GIT_COMMIT}"
                        echo "Branch: ${GIT_BRANCH}"
                    }
                }
            }
        }

        // 2. Compilación y tests - CORREGIDO
        stage('Build & Test') {
            steps {
                script {
                    dir('petconnect') {
                        sh 'mvn -B -ntp clean verify'
                    }
                }
            }
            post {
                success {
                    echo '✅ Build y tests completados'
                }
                failure {
                    echo '❌ Falló el build o tests'
                    emailext (
                        subject: "PetConnect CI FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: "El build falló. Revisa: ${env.BUILD_URL}",
                        to: 'tu-email@ejemplo.com'
                    )
                }
            }
        }

        // 3. Build de la imagen Docker - CORREGIDO
        stage('Build Docker Image') {
            steps {
                script {
                    dir('petconnect') {
                        docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                        docker.build("${IMAGE_NAME}:latest")
                    }
                }
            }
        }

        // 4. (Opcional) Push a DockerHub
        stage('Push to DockerHub') {
            when {
                expression { return env.REGISTRY != '' }
            }
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub-creds') {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                        docker.image("${IMAGE_NAME}:latest").push()
                    }
                }
            }
        }

        // 5. Despliegue con docker-compose - CORREGIDO
        stage('Deploy') {
            steps {
                script {
                    dir('petconnect') {
                        sh '''
                            docker-compose down
                            docker-compose up -d --build
                        '''
                    }
                }
            }
        }
    }
}